# ============================================================================
# PHP Shield — environment variables (names + placeholders only; never commit real values)
# ============================================================================
# PHP Shield is its OWN Render service (`php-shield-api`) plus one cron
# (`php-shield-monthly-rescan`), defined in render.php-shield.yaml. It has its OWN
# Supabase project — nothing here is shared with Foundation or Switchboard.
#
# Tags:  [API] = php-shield-api web service    [CRON] = monthly rescan cron
# The API REFUSES TO BOOT in production (PHP_SHIELD_ENV=production, or RENDER set) if any
# REQUIRED [API] variable is missing; /health reports what is missing without revealing values.
# ============================================================================


# ─── Supabase (PHP Shield's own project) ────────────────────────────────────
# [API][CRON] REQUIRED — Project URL (Supabase -> Project Settings -> API).
PHP_SHIELD_SUPABASE_URL=https://your-php-shield-project.supabase.co
# [API][CRON] REQUIRED — the service_role key (server only; bypasses RLS). Never expose to a browser.
PHP_SHIELD_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key


# ─── Stripe ─────────────────────────────────────────────────────────────────
# [API] REQUIRED — sk_test_... while testing, sk_live_... at launch.
STRIPE_SECRET_KEY=sk_test_xxx
# [API] REQUIRED — whsec_... signing secret of the webhook endpoint
# (https://<service>/php-shield/stripe/webhook; events: checkout.session.completed, invoice.paid,
# customer.subscription.deleted). Printed by: python scripts/create_stripe_products.py --webhook-url <url>
STRIPE_WEBHOOK_SECRET=whsec_xxx
# [API] REQUIRED — price ids printed by scripts/create_stripe_products.py (amounts come from
# app/app/php_shield/tiers.yaml: $300 / $750 / $1,500 one-time, $99/month).
STRIPE_PRICE_PHPSHIELD_BASIC=price_xxx
STRIPE_PRICE_PHPSHIELD_STANDARD=price_xxx
STRIPE_PRICE_PHPSHIELD_COMPLEX=price_xxx
STRIPE_PRICE_PHPSHIELD_MAINTENANCE=price_xxx


# ─── Email (Resend — the provider already used by Automaition Nation) ───────
# [API][CRON] REQUIRED — Resend API key.
RESEND_API_KEY=re_xxx
# [API][CRON] REQUIRED — where owner notifications (new paid order, signed authorization, quote
# requests) and operational alerts go.
PHP_SHIELD_OWNER_EMAIL=you@example.com
# [API][CRON] OPTIONAL — From address; must be on a Resend-verified domain.
PHP_SHIELD_FROM_EMAIL=PHP Shield <shield@automaitionnation.com>


# ─── Security / abuse controls ──────────────────────────────────────────────
# [API] REQUIRED — key for the admin page/API (header X-Admin-Key). Render can generate it
# (render.php-shield.yaml uses generateValue). Long random string.
PHP_SHIELD_ADMIN_API_KEY=your-long-random-admin-key
# [API] REQUIRED — salt for hashing client IPs in rate-limit and lead records. Render generates it.
PHP_SHIELD_IP_HASH_SALT=your-long-random-salt
# [API] OPTIONAL — Cloudflare Turnstile SECRET. When set, /scan requires a valid Turnstile token
# (fails closed). Pair it with VITE_TURNSTILE_SITE_KEY on the marketing site. Unset = skipped
# (honeypot + rate limits still apply).
TURNSTILE_SECRET=
# [API] OPTIONAL — comma-separated CORS origins. Default: the marketing site (+ www); localhost
# is added ONLY outside production.
PHP_SHIELD_ALLOWED_ORIGINS=
# [API] OPTIONAL — rate limits (defaults shown).
PHP_SHIELD_LIMIT_IP_PER_HOUR=5
PHP_SHIELD_LIMIT_DOMAIN_PER_DAY=3
PHP_SHIELD_LIMIT_GLOBAL_PER_DAY=500
PHP_SHIELD_MAX_CONCURRENT_SCANS=4


# ─── Alerts / operations ────────────────────────────────────────────────────
# [API][CRON] OPTIONAL — Slack (or Discord-compatible) webhook; alerts also go to the owner email.
SLACK_WEBHOOK_URL=
# [API][CRON] OPTIONAL — local fallback file for writes that failed (dead letters). Render's disk
# is ephemeral; the database copy (table dead_letters) and the alert email are the durable records.
PHP_SHIELD_DEAD_LETTER_PATH=dead_letters/php_shield.jsonl


# ─── Deployment ─────────────────────────────────────────────────────────────
# [API][CRON] "production" turns on refuse-to-boot validation. Render also sets RENDER=true
# automatically, which counts as production.
PHP_SHIELD_ENV=production
# [API][CRON] AUTOMATIC — Render sets RENDER=true itself; never set it by hand. Its presence is
# treated as production (refuse-to-boot validation on, localhost CORS off).
# RENDER=true
# [API][CRON] OPTIONAL — public marketing site (used in email links, Stripe return URLs, CORS).
PHP_SHIELD_SITE_URL=https://automaitionnation.com


# ─── Tests only (not read by the service) ───────────────────────────────────
# PHP_SHIELD_TEST_PG_DSN=postgresql://postgres@localhost:5432/postgres
#   Enables tests/php_shield/test_sql_guards.py, which runs the real migrations on a scratch
#   PostgreSQL and checks the database-enforced fulfillment gate and append-only authorizations.
#   Needs:  pip install pg8000
