# ============================================================================
# Foundation API — Environment Variables (names + placeholders only)
# ============================================================================
# Service: Render web service `foundation-api` (app/, `uvicorn app.main:app`),
# plus the `rahab-review-ingestion` cron (app/render.yaml). Never commit real
# values — set them in Render → Environment.
#
# Generated 2026-10-23 by an AST-based scan (Python) / multi-line-aware scan
# (TS/JS) of every os.getenv / os.environ read in app/, including calls split
# across lines. One read is resolved indirectly (action_library/registry.py
# loops over REQUIRED_ENV; the only value registered anywhere is GHL_API_KEY).
#
# Scope: runtime vars of the deployed service. Excluded on purpose: test-only
# vars (app/tests), dev tooling (.agents, .claude gate scripts), and
# sql/run_migrations.py (a local dev script — see docs/state/ENV_VARS.md).
# Runtime tags: [API] = foundation-api web service, [CRON] = rahab cron too.
# ============================================================================


# ─── Core: Supabase (Foundation project) ────────────────────────────────────
# [API][CRON] REQUIRED — app/config.py, voice_edit/*. No default.
SUPABASE_URL=https://your-project.supabase.co
# [API] REQUIRED — app/config.py:7, switchboard_db.py.
SUPABASE_ANON_KEY=your-anon-key
# [API][CRON] REQUIRED — app/config.py:8, voice_edit/session_manager.py:38
# (create_client at import time — the app will not start without it). Server only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# [API] OPTIONAL — routers/voice_employee_builder.py:43 reads this DIFFERENT
# name for the same service-role key (default ""). Set it to the same value or
# that router talks to Supabase unauthenticated.
SUPABASE_SERVICE_KEY=your-service-role-key


# ─── Auth / gating ──────────────────────────────────────────────────────────
# [API] REQUIRED — main.py:43. Gate for every internal router (require_api_key).
# Fails closed: 503 on gated routes if unset. Same value is shared with
# an-sales-pipeline, luts-api, delivered-web.
FOUNDATION_API_KEY=your-foundation-api-key
# [API] REQUIRED IN PRODUCTION — main.py:28. Comma-separated CORS origins.
# Default (when empty) is localhost only, which blocks every browser caller in
# production. Must include every site that calls this API from a browser:
# https://automaitionnation.com, https://www.automaitionnation.com (PHP Shield
# scan box), plus getswitchboard.io, www.getswitchboard.io,
# switchboard.automaitionnation.com, caleb.automaitionnation.com.
ALLOWED_ORIGINS=https://automaitionnation.com,https://www.automaitionnation.com
# [API] REQUIRED — services/connection_broker.py:16. Fernet key. The app refuses
# to start without it. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTION_BROKER_ENCRYPTION_KEY=your-fernet-key
# [API] REQUIRED where used — routers/research.py:51 (fails OPEN with a warning
# when unset), routers/pricing/routes.py:42, voice_edit/router.py:45. No default.
PIPELINE_API_KEY=your-shared-pipeline-key
# [API] REQUIRED IN PRODUCTION — voice_edit/session_manager.py:39. Signs voice-edit
# handoff JWTs. Code default is the literal "CHANGE-ME-IN-RENDER" — insecure if left.
VOICE_EDIT_HANDOFF_SECRET=your-random-handoff-secret
# [API] OPTIONAL — session_manager.py:41. Default https://app.automaitionnation.com.
VOICE_EDIT_PUBLIC_BASE_URL=https://app.automaitionnation.com
# [API] OPTIONAL — voice_edit/edit_engine.py:41. Path to the voice-edit config.
VOICE_EDIT_CONFIG=


# ─── LLMs ───────────────────────────────────────────────────────────────────
# [API][CRON] REQUIRED — llm_router.py, intent_parser.py. No default.
ANTHROPIC_API_KEY=sk-ant-xxx
# [API] OPTIONAL — gemini_voice_proxy.py:43 (GEMINI_API_KEY, falling back to
# GOOGLE_API_KEY). Required only for the Gemini voice proxy.
GEMINI_API_KEY=your-gemini-key
GOOGLE_API_KEY=
# [API] OPTIONAL — model tier overrides, llm_router.py / intent_parser.py. All
# have code defaults; docs/state/ENV_VARS.md lists the intended production values.
MODEL_ORCH_MAX=claude-fable-5-1
MODEL_COMPLEX=claude-opus-4-8
MODEL_STANDARD=claude-sonnet-5
MODEL_FAST=claude-haiku-4-5-20251001
MODEL_LONGCTX=claude-fable-5-1
MODEL_VOICE=gemini-3.1-flash-live
MODEL_FABLE_FALLBACK=claude-opus-4-8


# ─── Integrations ───────────────────────────────────────────────────────────
# [API][CRON] REQUIRED for GHL features — ghl_client.py, ops_audit.py, Rahab/Silas
# actions. Without it the action library falls back to demo (simulated) mode.
GHL_API_KEY=your-ghl-api-key
# [API] OPTIONAL — ops_audit.py:35. Distance Matrix + Geocoding (Silas/Zacchaeus/Rahab).
GOOGLE_MAPS_API_KEY=your-google-maps-key
# [API] OPTIONAL — connections/google_oauth.py. Connections Hub Google OAuth client.
GOOGLE_OAUTH_CLIENT_ID=your-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-oauth-client-secret
# [API] OPTIONAL — voice_employee_builder.py:39. Default "".
VAPI_API_KEY=your-vapi-private-key
# [API] OPTIONAL — Foundation's own public URL, defaults to the live host.
# FOUNDATION_API_BASE_URL: Google OAuth redirect base (connections/google_oauth.py:46,
# redirect = {base}/connections/callback/google — must match the GCP OAuth client).
# FOUNDATION_API_URL: routers/voice_employee_builder.py:44.
FOUNDATION_API_URL=https://foundation-api-9gpl.onrender.com
FOUNDATION_API_BASE_URL=https://foundation-api-9gpl.onrender.com
# [API] OPTIONAL — "1"/"true"/"yes" forces the action library into simulation.
ACTION_LIBRARY_DEMO_MODE=
# [API] OPTIONAL — Automation Nation Supabase (auth.py:39-40). Code defaults to
# the AN project URL and its anon key (public by design).
AN_SUPABASE_URL=https://your-an-project.supabase.co
AN_SUPABASE_ANON_KEY=your-an-anon-key


# ─── Switchboard ────────────────────────────────────────────────────────────
# [API] switchboard/switchboard_db.py, switchboard/router.py, switchboard/auth.py.
# Switchboard's own Supabase project (names only; Addendum F.5).
SWITCHBOARD_DB_MODE=foundation
SWITCHBOARD_SUPABASE_URL=
SWITCHBOARD_SUPABASE_SERVICE_ROLE_KEY=
SWITCHBOARD_SUPABASE_ANON_KEY=
SWITCHBOARD_SUPABASE_JWT_SECRET=
SWITCHBOARD_PROJECT_REF=
# [API] Phase 1 API token (auth.py:32); keep separate from the Supabase JWT secret.
SWITCHBOARD_JWT_SECRET=
# [API] OPTIONAL — switchboard_db.py:77. Not used directly: the startup guard
# refuses to boot if SWITCHBOARD_SUPABASE_JWT_SECRET equals this value or
# SWITCHBOARD_JWT_SECRET (F.9.7). Set it only so that guard can compare.
SUPABASE_JWT_SECRET=


# ─── PHP SHIELD ─────────────────────────────────────────────────────────────
# Code: app/app/php_shield/ + app/app/routers/php_shield.py (merged, PR #4).
# Served by THIS service. It reads NO env vars of its own — everything below is
# already declared above and listed here only so you know what the product
# depends on:
#   POST /php-shield/scan, POST /php-shield/report   PUBLIC (no API key)
#   GET  /php-shield/leads/{id}                      gated by FOUNDATION_API_KEY
#
#   ALLOWED_ORIGINS              [API] REQUIRED — the marketing site's scan box
#                                 calls this from the browser; origin must be listed.
#   SUPABASE_URL +
#   SUPABASE_SERVICE_ROLE_KEY    [API] REQUIRED — lead capture (foundation.php_shield_leads).
#                                 NOTE: a failed lead insert is deliberately swallowed
#                                 so the visitor still gets their report, so a missing
#                                 key means leads are silently NOT saved.
#   FOUNDATION_API_KEY           [API] REQUIRED — admin lead lookup (503 if unset).
#   CONNECTION_BROKER_ENCRYPTION_KEY  [API] REQUIRED — startup guard for the whole app.
# Non-env prerequisites: apply supabase/migrations/*_php_shield_schema.sql and
# sql/seeds/003_php_shield_agent.sql. The frontend that calls it (the free-scan
# section on automaitionnation.com) is NOT built yet; when it is, it will use the
# existing VITE_FOUNDATION_API_URL (automaition-nation repo) — no new var.
# Note: public endpoints currently have no rate limiting.


# ─── Internal frontend (frontend/, Next.js — separate from the API) ─────────
# [FRONTEND] frontend/lib/supabase.js:3-4 — no defaults.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# [FRONTEND-SERVER] frontend route handler (route.js:4) reads ANTHROPIC_API_KEY
# server-side; set the same name in that app's environment.
